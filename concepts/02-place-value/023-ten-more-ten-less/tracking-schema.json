{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 2: Ten More Ten Less - Student Progress Tracking Schema",
  "type": "object",
  "properties": {
    "conceptId": {
      "type": "string",
      "const": "023-ten-more-ten-less"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "bestScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "mastered": {
      "type": "boolean"
    },
    "mistakePatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "added_one_instead_of_ten",
          "no_change",
          "added_ten_and_one",
          "removed_one_instead_of_ten",
          "removed_ten_and_one",
          "incorrect_choice"
        ]
      }
    }
  },
  "required": ["conceptId", "attempts", "bestScore", "mastered", "mistakePatterns"]
}
