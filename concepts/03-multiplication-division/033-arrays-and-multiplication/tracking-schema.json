{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 3: Arrays & Multiplication - Student Progress Tracking Schema",
  "type": "object",
  "properties": {
    "conceptId": {
      "type": "string",
      "const": "033-arrays-and-multiplication"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "bestScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "mastered": {
      "type": "boolean"
    },
    "mistakePatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "row_column_reversal",
          "corner_double_count",
          "disorganized_grid",
          "incorrect_total"
        ]
      }
    }
  },
  "required": ["conceptId", "attempts", "bestScore", "mastered", "mistakePatterns"]
}
