{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage 3: Odd and Even Numbers - Student Progress Tracking Schema",
  "type": "object",
  "properties": {
    "conceptId": {
      "type": "string",
      "const": "035-odd-and-even-numbers"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "bestScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "mastered": {
      "type": "boolean"
    },
    "mistakePatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tens_digit_confusion",
          "zero_misclassification",
          "pair_leftover_error",
          "incorrect_classification"
        ]
      }
    }
  },
  "required": ["conceptId", "attempts", "bestScore", "mastered", "mistakePatterns"]
}
